# Rust build artifacts
target/

# demo/ artifacts: run_cli.sh compiles gen_prompt from reference-c/ on every
# run, and the REPLs byte-compile the tokenizer module. Both are rebuilt on
# demand -- neither is source.
demo/gen_prompt
__pycache__/

# macOS Finder metadata
.DS_Store

# Editor/IDE state. The ESP-IDF VS Code extension writes machine-specific
# absolute toolchain paths into .vscode/, so none of it is portable.
.vscode/
.idea/

# Local scratch / cleanup staging (not part of the tracked project)
engine/_to_delete/
/_to_delete/
model/_to_delete/

# Xtensa/ESP-IDF template output (esp32-rust/) is its own separate,
# not-yet-folded-in project -- deliberately not tracked here until it's
# merged into engine/llm-firmware/ per MIGRATION_PLAN.md.
esp32-rust/

# ESP-IDF build tooling, if generated locally
.embuild/

# training/ (vendored Python pipeline): downloaded corpus, checkpoints, and
# exported artifacts. Generated, large, and reproducible -- none of it is source.
training/data/
training/runs/
training/artifacts/
training/generated/
training/.venv/
*.pyc
*.egg-info/

# Device run logs -- transient. Figures worth keeping go in benchmarks/device.toml.
runs/
